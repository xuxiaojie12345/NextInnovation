<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.ProductClassMasterMapper">
    
    <resultMap id="ProductClassMasterResultMap" type="com.web.app.entity.ProductClassMaster">
        <id property="pc" column="PC"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>
    
    <!-- 查询所有产品类别 -->
    <select id="selectAll" resultMap="ProductClassMasterResultMap">
        SELECT * FROM PRODUCT_CLASS_MASTER
    </select>
    
</mapper>
