<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD18Mapper">

    <select id="selectFunctionAuth" resultType="string">
        SELECT FUNCTION FROM HDOC_FUNCTION_AUTH WHERE USERID = #{userId}
    </select>

    <select id="selectUsername" resultType="string">
        SELECT USERNAME FROM HDOC_USER_INFOR WHERE USERID = #{userId}
    </select>

    <select id="selectUserDoc" resultType="string">
        SELECT DOCTYPE FROM HDOC_USER_DOC WHERE USERID = #{userId}
    </select>

    <delete id="deleteUserDoc">
        DELETE FROM HDOC_USER_DOC WHERE USERID = #{userId}
    </delete>

    <insert id="insertUserDoc">
        INSERT INTO HDOC_USER_DOC (USERID, DOCTYPE) VALUES (#{userId}, #{doctype})
    </insert>

</mapper>
