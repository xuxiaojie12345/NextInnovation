<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocFunctionAuthMapper">

    <resultMap id="BaseResultMap" type="com.web.app.entity.HdocFunctionAuth">
        <result property="userid" column="USERID" jdbcType="VARCHAR"/>
        <result property="functionField" column="FUNCTION" jdbcType="VARCHAR"/>
        <result property="registerDatetime" column="REGISTER_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="registerUser" column="REGISTER_USER" jdbcType="VARCHAR"/>
        <result property="registerProcess" column="REGISTER_PROCESS" jdbcType="VARCHAR"/>
        <result property="updateDatetime" column="UPDATE_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
        <result property="updateProcess" column="UPDATE_PROCESS" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectByUserid" resultMap="BaseResultMap">
        SELECT * FROM HDOC_FUNCTION_AUTH WHERE USERID = #{userid}
    </select>

    <update id="updateByUserid" parameterType="com.web.app.entity.HdocFunctionAuth">
        UPDATE HDOC_FUNCTION_AUTH
        SET FUNCTION = #{functionField},
            UPDATE_USER = #{updateUser},
            UPDATE_DATETIME = #{updateDatetime},
            UPDATE_PROCESS = #{updateProcess}
        WHERE USERID = #{userid}
    </update>

    <delete id="deleteByUserid">
        DELETE FROM HDOC_FUNCTION_AUTH WHERE USERID = #{userid}
    </delete>

</mapper>
