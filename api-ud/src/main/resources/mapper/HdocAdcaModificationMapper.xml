<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocAdcaModificationMapper">

    <resultMap id="BaseResultMap" type="com.web.app.entity.HdocAdcaModification">
        <result property="serie" column="SERIE" jdbcType="VARCHAR"/>
        <result property="chno" column="CHNO" jdbcType="VARCHAR"/>
        <result property="doctype" column="DOCTYPE" jdbcType="VARCHAR"/>
        <result property="lang" column="LANG" jdbcType="VARCHAR"/>
        <result property="variable" column="VARIABLE" jdbcType="VARCHAR"/>
        <result property="vers" column="VERS" jdbcType="NUMERIC"/>
        <result property="newval" column="NEWVAL" jdbcType="VARCHAR"/>
        <result property="sta" column="STA" jdbcType="NUMERIC"/>
        <result property="bu" column="BU" jdbcType="VARCHAR"/>
        <result property="releaseUser" column="RELEASE_USER" jdbcType="VARCHAR"/>
        <result property="releaseDateTime" column="RELEASE_DATE_TIME" jdbcType="TIMESTAMP"/>
        <result property="registerDatetime" column="REGISTER_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="registerUser" column="REGISTER_USER" jdbcType="VARCHAR"/>
        <result property="registerProcess" column="REGISTER_PROCESS" jdbcType="VARCHAR"/>
        <result property="updateDatetime" column="UPDATE_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
        <result property="updateProcess" column="UPDATE_PROCESS" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectBySerieAndChno" resultMap="BaseResultMap">
        SELECT * FROM HDOC_ADCA_MODIFICATION WHERE SERIE = #{serie} AND CHNO = #{chno}
    </select>

    <update id="updateNewvalByVariable" parameterType="com.web.app.entity.HdocAdcaModification">
        UPDATE HDOC_ADCA_MODIFICATION
        SET NEWVAL = #{newval},
            UPDATE_DATETIME = #{updateDatetime},
            UPDATE_USER = #{updateUser},
            UPDATE_PROCESS = #{updateProcess}
        WHERE SERIE = #{serie} AND CHNO = #{chno} AND VARIABLE = #{variable}
    </update>

</mapper>
