<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocSendDataVinPlateMapper">

    <resultMap id="BaseResultMap" type="com.web.app.entity.HdocSendDataVinPlate">
        <result property="serie" column="SERIE" jdbcType="VARCHAR"/>
        <result property="chnr" column="CHNR" jdbcType="VARCHAR"/>
        <result property="pc" column="PC" jdbcType="VARCHAR"/>
        <result property="added" column="ADDED" jdbcType="VARCHAR"/>
        <result property="docReady" column="DOC_READY" jdbcType="VARCHAR"/>
        <result property="docSent" column="DOC_SENT" jdbcType="VARCHAR"/>
        <result property="bu" column="BU" jdbcType="VARCHAR"/>
        <result property="status" column="STATUS" jdbcType="NUMERIC"/>
        <result property="xmlDoc" column="XML_DOC" jdbcType="VARCHAR"/>
        <result property="msg" column="MSG" jdbcType="VARCHAR"/>
        <result property="typeField" column="TYPE" jdbcType="VARCHAR"/>
        <result property="isJsDivision" column="IS_JS_DIVISION" jdbcType="VARCHAR"/>
        <result property="ordernumber" column="ORDERNUMBER" jdbcType="VARCHAR"/>
        <result property="filenameOnDisk" column="FILENAME_ON_DISK" jdbcType="VARCHAR"/>
        <result property="adcaChangeFlg" column="ADCA_CHANGE_FLG" jdbcType="VARCHAR"/>
        <result property="registerDatetime" column="REGISTER_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="registerUser" column="REGISTER_USER" jdbcType="VARCHAR"/>
        <result property="registerProcess" column="REGISTER_PROCESS" jdbcType="VARCHAR"/>
        <result property="updateDatetime" column="UPDATE_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
        <result property="updateProcess" column="UPDATE_PROCESS" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectBySerieAndChnr" resultMap="BaseResultMap">
        SELECT * FROM HDOC_SEND_DATA_VIN_PLATE WHERE SERIE = #{serie} AND CHNR = #{chnr}
    </select>

    <update id="updateStatus">
        UPDATE HDOC_SEND_DATA_VIN_PLATE
        SET STATUS = #{status}
        WHERE SERIE = #{serie} AND CHNR = #{chnr}
    </update>

    <update id="updateStatusAndType">
        UPDATE HDOC_SEND_DATA_VIN_PLATE
        SET STATUS = #{status}, TYPE = #{type}
        WHERE SERIE = #{serie} AND CHNR = #{chnr}
    </update>

</mapper>
