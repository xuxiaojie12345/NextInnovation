<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocRecDataOmMapper">
    <select id="selectByChassisNo" resultType="com.web.app.entity.HdocRecDataOm">
        SELECT * FROM HDOC_REC_DATA_OM WHERE VIN = #{chassisNo} ORDER BY ORDERNUMBER LIMIT 1
    </select>
</mapper>
