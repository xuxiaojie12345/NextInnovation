<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD14SearchMapper">

    <select id="selectAllMarketCodes" resultType="string">
        SELECT MARKET FROM MARKET_MASTER
    </select>

    <select id="selectVariablesByVal" resultType="string">
        SELECT VARIABLE FROM HDOC_USER_DEFINED_RULES WHERE VAL = #{val}
    </select>

</mapper>
