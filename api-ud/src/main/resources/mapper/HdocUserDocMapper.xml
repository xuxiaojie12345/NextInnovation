<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocUserDocMapper">

    <resultMap id="BaseResultMap" type="com.web.app.entity.HdocUserDoc">
        <result property="userid" column="USERID" jdbcType="VARCHAR"/>
        <result property="doctype" column="DOCTYPE" jdbcType="VARCHAR"/>
        <result property="registerDatetime" column="REGISTER_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="registerUser" column="REGISTER_USER" jdbcType="VARCHAR"/>
        <result property="registerProcess" column="REGISTER_PROCESS" jdbcType="VARCHAR"/>
        <result property="updateDatetime" column="UPDATE_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
        <result property="updateProcess" column="UPDATE_PROCESS" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectByUserid" resultMap="BaseResultMap">
        SELECT * FROM HDOC_USER_DOC WHERE USERID = #{userid}
    </select>

    <delete id="deleteByUserid">
        DELETE FROM HDOC_USER_DOC WHERE USERID = #{userid}
    </delete>

    <insert id="insert" parameterType="com.web.app.entity.HdocUserDoc">
        INSERT INTO HDOC_USER_DOC (USERID, DOCTYPE, REGISTER_USER, REGISTER_DATETIME, REGISTER_PROCESS, UPDATE_USER, UPDATE_DATETIME, UPDATE_PROCESS)
        VALUES (#{userid}, #{doctype}, #{registerUser}, #{registerDatetime}, #{registerProcess}, #{updateUser}, #{updateDatetime}, #{updateProcess})
    </insert>

</mapper>
