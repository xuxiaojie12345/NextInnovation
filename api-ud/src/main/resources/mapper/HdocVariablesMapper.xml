<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocVariablesMapper">

    <!-- 检查变量是否已存在 -->
    <select id="countByVariable" resultType="int">
        SELECT COUNT(*) FROM HDOC_VARIABLES WHERE VARIABLE = #{variable}
    </select>

    <!-- 插入新记录 -->
    <insert id="insert" parameterType="com.web.app.domain.Entity.HdocVariables">
        INSERT INTO HDOC_VARIABLES (
            VARIABLE,
            TYPE,
            DESCRIPTION,
            REGISTER_DATETIME,
            REGISTER_USER,
            REGISTER_PROCESS,
            UPDATE_DATETIME,
            UPDATE_USER,
            UPDATE_PROCESS
        ) VALUES (
            #{variable},
            #{type},
            #{description},
            CURRENT_TIMESTAMP,
            #{registerUser},
            #{registerProcess},
            CURRENT_TIMESTAMP,
            #{updateUser},
            #{updateProcess}
        )
    </insert>

    <!-- 更新记录 -->
    <update id="update" parameterType="com.web.app.domain.Entity.HdocVariables">
        UPDATE HDOC_VARIABLES SET
            TYPE = #{type},
            DESCRIPTION = #{description},
            UPDATE_DATETIME = CURRENT_TIMESTAMP,
            UPDATE_USER = #{updateUser},
            UPDATE_PROCESS = #{updateProcess}
        WHERE VARIABLE = #{variable}
    </update>

    <!-- 删除记录（物理删除） -->
    <delete id="deleteByVariable">
        DELETE FROM HDOC_VARIABLES WHERE VARIABLE = #{variable}
    </delete>

    <!-- UD11: 搜索变量（支持 eq/ne 操作符） -->
    <!-- 操作符说明：eq(=) / ne(!=) -->
    <select id="searchVariables" resultType="com.web.app.domain.Entity.HdocVariables">
        SELECT
            VARIABLE,
            TYPE,
            DESCRIPTION,
            REGISTER_USER,
            REGISTER_DATETIME
        FROM HDOC_VARIABLES
        WHERE 1=1
            <!-- VARIABLE: 精确匹配 eq 或 ne -->
            <choose>
                <when test="varOp == 'ne'">
                    AND VARIABLE != #{variable}
                </when>
                <otherwise>
                    AND VARIABLE = #{variable}
                </otherwise>
            </choose>
            <!-- TYPE: 可选，eq 对应 LIKE, ne 对应 NOT LIKE -->
            <if test="type != null and type != ''">
                <choose>
                    <when test="typeOp == 'ne'">
                        AND (TYPE NOT LIKE CONCAT('%', #{type}, '%') OR TYPE IS NULL)
                    </when>
                    <otherwise>
                        AND TYPE LIKE CONCAT('%', #{type}, '%')
                    </otherwise>
                </choose>
            </if>
            <!-- DESCRIPTION: 可选，eq 对应 LIKE, ne 对应 NOT LIKE -->
            <if test="description != null and description != ''">
                <choose>
                    <when test="descrOp == 'ne'">
                        AND (DESCRIPTION NOT LIKE CONCAT('%', #{description}, '%') OR DESCRIPTION IS NULL)
                    </when>
                    <otherwise>
                        AND DESCRIPTION LIKE CONCAT('%', #{description}, '%')
                    </otherwise>
                </choose>
            </if>
            <!-- REGISTER_USER: 可选，eq 对应 LIKE, ne 对应 NOT LIKE -->
            <if test="createdByUser != null and createdByUser != ''">
                <choose>
                    <when test="userOp == 'ne'">
                        AND (REGISTER_USER NOT LIKE CONCAT('%', #{createdByUser}, '%') OR REGISTER_USER IS NULL)
                    </when>
                    <otherwise>
                        AND REGISTER_USER LIKE CONCAT('%', #{createdByUser}, '%')
                    </otherwise>
                </choose>
            </if>
            <!-- REGISTER_DATETIME: 可选，eq 对应 =, ne 对应 != -->
            <if test="date != null and date != ''">
                <choose>
                    <when test="dateOp == 'ne'">
                        AND REGISTER_DATETIME != #{date}
                    </when>
                    <otherwise>
                        AND REGISTER_DATETIME = #{date}
                    </otherwise>
                </choose>
            </if>
    </select>

</mapper>
