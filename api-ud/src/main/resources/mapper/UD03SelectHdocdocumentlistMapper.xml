<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD03SelectHdocdocumentlistMapper">

    <!--
        UD03 获取文档类型列表查询
        SELECT DOCTYPE FROM HDOC_DOCUMENT_LIST ORDER BY DOCTYPE
        功能说明：从 HDOC_DOCUMENT_LIST 表中查询所有文档类型，按 DOCTYPE 排序
    -->
    <select id="selectDoctypeList" resultType="java.lang.String">
        SELECT DOCTYPE
        FROM HDOC_DOCUMENT_LIST
        ORDER BY DOCTYPE
    </select>

</mapper>
