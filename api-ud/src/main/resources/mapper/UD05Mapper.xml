<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD05Mapper">

    <!--
        UD05SelectVariableModification
        根据serie和chno关联查询HDOC_ADCA_MODIFICATION（左连接）HDOC_VARIABLES，获取变量信息
        若HDOC_ADCA_MODIFICATION中不存在对应变量，则Current value和Modified value均为空
        对应详细设计：DES-ModifyDocument-001 - 4.1 接口定义 / 5.1 查询语句
    -->
    <resultMap id="variableResultMap" type="com.web.app.domain.ModifyDocumentQueryResponse$VariableInfo">
        <result property="variable" column="variable"/>
        <result property="description" column="description"/>
        <result property="currentValue" column="currentValue"/>
        <result property="modifiedValue" column="modifiedValue"/>
    </resultMap>

    <select id="selectVariableModification" resultMap="variableResultMap">
        SELECT
            a.VARIABLE AS variable,
            b.DESCRIPTION AS description,
            a.NEWVAL AS currentValue,
            a.NEWVAL AS modifiedValue
        FROM HDOC_ADCA_MODIFICATION a
        LEFT JOIN HDOC_VARIABLES b ON a.VARIABLE = b.VARIABLE
        WHERE a.SERIE = #{serie} AND a.CHNO = #{chno}
    </select>

    <!--
        UD05UpdateHdocAdcaModification
        更新HDOC_ADCA_MODIFICATION表的NEWVAL字段
        对应详细设计：DES-ModifyDocument-001 - 4.1 更新接口 / 5.2 更新语句
    -->
    <update id="updateHdocAdcaModification">
        UPDATE HDOC_ADCA_MODIFICATION
        SET NEWVAL = #{modifiedValue}
        WHERE SERIE = #{serie} AND CHNO = #{chno} AND VARIABLE = #{variable}
    </update>

</mapper>
