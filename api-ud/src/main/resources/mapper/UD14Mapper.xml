<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD14Mapper">

    <resultMap id="MarketMasterMap" type="com.web.app.domain.entity.MarketMaster">
        <id column="MARKET" property="market"/>
        <result column="DESCRIPTION" property="description"/>
    </resultMap>

    <!-- UD14SelectMarketmaster: 查询所有市场信息 -->
    <select id="selectAllMarketMaster" resultMap="MarketMasterMap">
        SELECT MARKET, DESCRIPTION FROM MARKET_MASTER ORDER BY MARKET
    </select>

    <!-- UD14SelectHdocuserdefinedrules: 查询文件引用次数
         对应全体APIのプロンプト.txt 5.2 -->
    <select id="countByMarketAndFileName" resultType="int">
        SELECT COUNT(*) FROM HDOC_USER_DEFINED_RULES
        WHERE MarketCd = #{market} AND Val = #{val}
    </select>

</mapper>
