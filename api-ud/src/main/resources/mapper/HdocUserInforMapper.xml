<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocUserInforMapper">

    <resultMap id="BaseResultMap" type="com.web.app.entity.HdocUserInfor">
        <result property="userid" column="USERID" jdbcType="VARCHAR"/>
        <result property="password" column="PASSWORD" jdbcType="VARCHAR"/>
        <result property="username" column="USERNAME" jdbcType="VARCHAR"/>
        <result property="responsible" column="RESPONSIBLE" jdbcType="VARCHAR"/>
        <result property="userposition" column="USERPOSITION" jdbcType="VARCHAR"/>
        <result property="email" column="EMAIL" jdbcType="VARCHAR"/>
        <result property="registerDatetime" column="REGISTER_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="registerUser" column="REGISTER_USER" jdbcType="VARCHAR"/>
        <result property="registerProcess" column="REGISTER_PROCESS" jdbcType="VARCHAR"/>
        <result property="updateDatetime" column="UPDATE_DATETIME" jdbcType="TIMESTAMP"/>
        <result property="updateUser" column="UPDATE_USER" jdbcType="VARCHAR"/>
        <result property="updateProcess" column="UPDATE_PROCESS" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM hdoc_user_infor WHERE USERID = #{userId}
    </select>

    <select id="findByUserIdAndPassword" resultMap="BaseResultMap">
        SELECT * FROM hdoc_user_infor WHERE USERID = #{userId} AND PASSWORD = #{password}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(1) FROM hdoc_user_infor WHERE USERID = #{userId}
    </select>

</mapper>
