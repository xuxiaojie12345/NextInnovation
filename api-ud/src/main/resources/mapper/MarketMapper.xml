<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.MarketMapper">

    <resultMap id="BaseResultMap" type="com.web.app.domain.entity.MarketMaster">
        <id column="market" property="market" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="register_datetime" property="registerDatetime" jdbcType="TIMESTAMP"/>
        <result column="register_user" property="registerUser" jdbcType="VARCHAR"/>
        <result column="register_process" property="registerProcess" jdbcType="VARCHAR"/>
        <result column="update_datetime" property="updateDatetime" jdbcType="TIMESTAMP"/>
        <result column="update_user" property="updateUser" jdbcType="VARCHAR"/>
        <result column="update_process" property="updateProcess" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="findAllMarkets" resultMap="BaseResultMap">
        SELECT market FROM market_master
    </select>

</mapper>
