<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- HdocDocumentListMapperインターフェースと紐づくSQLマッピングファイル -->
<mapper namespace="com.web.app.mapper.HdocDocumentListMapper">

    <!-- DocumentTypeリストを取得 -->
    <select id="getDocumentType" resultType="com.web.app.domain.entity.HdocDocumentList">
        SELECT DOCTYPE
        FROM hdoc_document_list
    </select>

</mapper>
