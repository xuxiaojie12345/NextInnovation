<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.HdocDocumentListMapper">

    <!-- 结果映射 -->
    <resultMap id="HdocDocumentListResultMap" type="com.web.app.domain.HdocDocumentList">
        <id property="doctype" column="DOCTYPE"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="registerDatetime" column="REGISTER_DATETIME"/>
        <result property="registerUser" column="REGISTER_USER"/>
        <result property="registerProcess" column="REGISTER_PROCESS"/>
        <result property="updateDatetime" column="UPDATE_DATETIME"/>
        <result property="updateUser" column="UPDATE_USER"/>
        <result property="updateProcess" column="UPDATE_PROCESS"/>
    </resultMap>

    <!-- 查询所有文档类型（去重） -->
    <select id="selectAllDoctypes" resultMap="HdocDocumentListResultMap">
        SELECT DISTINCT DOCTYPE, DESCRIPTION, REGISTER_DATETIME, REGISTER_USER, 
               REGISTER_PROCESS, UPDATE_DATETIME, UPDATE_USER, UPDATE_PROCESS
        FROM HDOC_DOCUMENT_LIST
        ORDER BY DOCTYPE
    </select>

    <!-- 动态条件查询文档列表 -->
    <select id="selectByConditions" parameterType="java.util.Map" resultType="java.util.LinkedHashMap">
        SELECT
            DOCTYPE,
            DESCRIPTION,
            REGISTER_USER,
            REGISTER_DATETIME
        FROM HDOC_DOCUMENT_LIST
        WHERE 1=1
        <if test="documentType != null and documentType != ''">
            AND DOCTYPE LIKE CONCAT('%', #{documentType}, '%')
        </if>
        ORDER BY DOCTYPE
    </select>

</mapper>
