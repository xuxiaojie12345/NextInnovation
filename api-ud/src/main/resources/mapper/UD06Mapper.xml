<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD06Mapper">

    <!--
        UD06SelectHdocAdcaModification
        根据serie和chno查询HDOC_ADCA_MODIFICATION表，获取DOCTYPE、VERS、VARIABLE、NEWVAL等信息
        对应详细设计：DES-SaveModifications-001 - 4.1 接口定义 / 5.1 查询语句
    -->
    <resultMap id="modificationResultMap" type="com.web.app.domain.SaveModificationsQueryResponse">
        <result property="doctype" column="doctype"/>
        <result property="version" column="vers"/>
        <result property="foundUnreleasedVersion" column="vers"/>
        <association property="storing" javaType="com.web.app.domain.SaveModificationsQueryResponse$StoringInfo">
            <result property="variable" column="variable"/>
            <result property="newval" column="newval"/>
        </association>
    </resultMap>

    <select id="selectHdocAdcaModification" resultMap="modificationResultMap">
        SELECT
            DOCTYPE AS doctype,
            VERS AS vers,
            VARIABLE AS variable,
            NEWVAL AS newval
        FROM HDOC_ADCA_MODIFICATION
        WHERE SERIE = #{serie} AND CHNO = #{chno}
    </select>

</mapper>
