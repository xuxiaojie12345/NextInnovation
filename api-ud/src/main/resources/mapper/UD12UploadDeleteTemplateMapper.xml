<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.UD12UploadDeleteTemplateMapper">

    <!-- 查询所有市场的通用结果映射 -->
    <resultMap id="marketResultMap" type="com.web.app.entity.MarketMaster">
        <result column="MARKET" property="market"/>
    </resultMap>

    <!-- 查询所有市场列表 -->
    <select id="getAllMarkets" resultMap="marketResultMap">
        SELECT MARKET FROM MARKET_MASTER
    </select>

</mapper>
