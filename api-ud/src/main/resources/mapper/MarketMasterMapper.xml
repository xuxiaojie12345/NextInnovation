<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.web.app.mapper.MarketMasterMapper">
    
    <resultMap id="MarketMasterResultMap" type="com.web.app.entity.MarketMaster">
        <id property="market" column="MARKET"/>
        <result property="description" column="DESCRIPTION"/>
    </resultMap>
    
    <!-- 查询所有市场 -->
    <select id="selectAll" resultMap="MarketMasterResultMap">
        SELECT * FROM MARKET_MASTER
    </select>
    
</mapper>
