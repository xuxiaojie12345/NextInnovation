package com.web.app.service.impl;

import com.web.app.dto.UD04SelectGeneratedocumentRequest;
import com.web.app.dto.UD04SelectGeneratedocumentResponse;
import com.web.app.mapper.UD04SelectGeneratedocumentMapper;
import com.web.app.service.UD04SelectGeneratedocumentService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

/**
 * UD04获取生成文档数据服务实现类
 */
@Slf4j
@Service
public class UD04SelectGeneratedocumentServiceImpl implements UD04SelectGeneratedocumentService {
    
    @Autowired
    private UD04SelectGeneratedocumentMapper ud04SelectGeneratedocumentMapper;
    
    @Override
    public UD04SelectGeneratedocumentResponse getUD04GenerateDocumentData(UD04SelectGeneratedocumentRequest request) {
        log.info("开始查询生成文档数据，chassisSerie={}, chassisNo={}", 
            request.getChassisSerie(), request.getChassisNo());
        
        UD04SelectGeneratedocumentResponse response = new UD04SelectGeneratedocumentResponse();
        
        try {
            // 查询文档数据
            UD04SelectGeneratedocumentResponse.DocumentData data = 
                ud04SelectGeneratedocumentMapper.selectDocumentData(
                    request.getChassisSerie(), 
                    request.getChassisNo()
                );
            
            if (data == null) {
                // 无匹配结果时返回空数组，前端显示友好提示
                response.setCode(200);
                response.setMsg("Chassis no is not exists.");
                response.setData(null);
                log.warn("未找到匹配的底盘数据: serie={}, chno={}", 
                    request.getChassisSerie(), request.getChassisNo());
            } else {
                response.setCode(200);
                response.setMsg("查询成功");
                response.setData(data);
                log.info("生成文档数据查询成功");
            }
            
        } catch (Exception e) {
            log.error("查询生成文档数据异常", e);
            response.setCode(500);
            response.setMsg("服务器内部错误");
            response.setData(null);
        }
        
        return response;
    }
}
