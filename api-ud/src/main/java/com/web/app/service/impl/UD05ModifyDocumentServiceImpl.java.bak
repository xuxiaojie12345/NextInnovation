package com.web.app.service.impl;

import com.web.app.dto.UD05ModifyDocumentRequest;
import com.web.app.dto.UD05ModifyDocumentUpdateRequest;
import com.web.app.dto.UD05SelectModifyDocumentResponse;
import com.web.app.dto.UD05UpdateModifyDocumentResponse;
import com.web.app.mapper.UD05ModifyDocumentMapper;
import com.web.app.service.UD05ModifyDocumentService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.List;

/**
 * UD05修改文档变量服务实现类
 */
@Slf4j
@Service
public class UD05ModifyDocumentServiceImpl implements UD05ModifyDocumentService {
    
    @Autowired
    private UD05ModifyDocumentMapper ud05ModifyDocumentMapper;
    
    @Override
    public UD05SelectModifyDocumentResponse UD05SelectVariableModification(UD05ModifyDocumentRequest request) {
        log.info("开始查询修改文档变量，chassisSerie={}, chassisNo={}", 
            request.getChassisSerie(), request.getChassisNo());
        
        UD05SelectModifyDocumentResponse response = new UD05SelectModifyDocumentResponse();
        
        try {
            // 查询修改数据
            List<UD05SelectModifyDocumentResponse.ModificationData> dataList = 
                ud05ModifyDocumentMapper.selectVariableModification(
                    request.getChassisSerie(), 
                    request.getChassisNo()
                );
            
            if (dataList == null || dataList.isEmpty()) {
                response.setCode(2002);
                response.setMsg("记录不存在");
                response.setData(new ArrayList<>());
                log.warn("未找到修改记录: serie={}, chno={}", 
                    request.getChassisSerie(), request.getChassisNo());
            } else {
                response.setCode(200);
                response.setMsg("查询成功");
                response.setData(dataList);
                log.info("修改文档变量查询成功，共{}条记录", dataList.size());
            }
            
        } catch (Exception e) {
            log.error("查询修改文档变量异常", e);
            response.setCode(500);
            response.setMsg("服务器内部错误");
            response.setData(new ArrayList<>());
        }
        
        return response;
    }
    
    @Override
    @Transactional(rollbackFor = Exception.class)
    public UD05UpdateModifyDocumentResponse UD05UpdateHdocAdcaModification(UD05ModifyDocumentUpdateRequest request) {
        log.info("开始更新修改文档变量，chassisSerie={}, chassisNo={}, description={}", 
            request.getChassisSerie(), request.getChassisNo(), request.getDescription());
        
        UD05UpdateModifyDocumentResponse response = new UD05UpdateModifyDocumentResponse();
        
        try {
            // 执行更新
            int rows = ud05ModifyDocumentMapper.updateHdocAdcaModification(
                request.getChassisSerie(),
                request.getChassisNo(),
                request.getDescription(),
                request.getNewVal()
            );
            
            if (rows == 0) {
                response.setCode(2002);
                response.setMsg("记录不存在");
                response.setData(null);
                log.warn("更新失败，记录不存在: serie={}, chno={}, desc={}", 
                    request.getChassisSerie(), request.getChassisNo(), request.getDescription());
            } else {
                response.setCode(200);
                response.setMsg("更新成功");
                response.setData(null);
                log.info("修改文档变量更新成功，影响行数: {}", rows);
            }
            
        } catch (Exception e) {
            log.error("更新修改文档变量异常", e);
            response.setCode(500);
            response.setMsg("服务器内部错误");
            response.setData(null);
        }
        
        return response;
    }
}
