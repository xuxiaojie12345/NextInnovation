# ---------------------------------------------------------------
# リポジトリ共通 .gitignore
# ---------------------------------------------------------------

# ローカル開発ツール（JDK / Maven など、サイズが大きくバイナリのため除外）
_tools/
**/_tools/

# 依存関係
node_modules/

# ビルド成果物
dist/
build/
target/

# IDE / エディタ
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
